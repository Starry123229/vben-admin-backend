# ===== 数据库（与 Java 端共用 init.sql） =====
DATABASE_URL="mysql://root:123456@localhost:3306/vben_admin"

# ===== JWT 密钥（生产务必更换） =====
JWT_ACCESS_SECRET=dev_access_secret_change_me_in_production
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_in_production

# ===== Token 有效期 =====
ACCESS_TOKEN_EXPIRES=2h
REFRESH_TOKEN_DAYS=7

# ===== 服务端口（与 Java 端保持一致，前端 vite 代理 target 指向此处） =====
PORT=8080

# ===== Cookie 配置 =====
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# ===== 登录方式开关（与 Java 端 application.yml 对齐） =====
LOGIN_METHODS_ACCOUNT=true
LOGIN_METHODS_PHONE=false
LOGIN_METHODS_QRCODE=false
LOGIN_METHODS_REGISTER=false
LOGIN_METHODS_OAUTH=false

# ===== 安全开关 =====
PHONE_AUTO_REGISTER=false
OAUTH_AUTO_REGISTER=false

# ===== 文件上传目录 =====
UPLOAD_DIR=./uploads

# ===== SMS/邮件 Mock =====
SMS_MOCK=true
EMAIL_MOCK=true
