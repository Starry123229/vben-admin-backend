generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model SysUser {
  id           BigInt   @id @default(autoincrement())
  username     String   @unique(map: "uk_username") @db.VarChar(64)
  passwordHash String   @map("password_hash") @db.VarChar(100)
  realName     String?  @map("real_name") @db.VarChar(64)
  avatar       String?  @db.VarChar(255)
  homePath     String?  @map("home_path") @db.VarChar(255)
  phone        String?  @unique(map: "uk_phone") @db.VarChar(32)
  email        String?  @unique(map: "uk_email") @db.VarChar(128)
  deptId       BigInt?  @map("dept_id")
  status       Int      @default(1) @db.TinyInt
  remark       String?  @db.VarChar(500)
  intro        String?  @db.VarChar(500)
  createTime   DateTime @default(now()) @map("create_time") @db.DateTime(0)
  updateTime   DateTime @default(now()) @map("update_time") @db.DateTime(0)

  userRoles    SysUserRole[]
  refreshTokens SysRefreshToken[]
  notices      SysNotice[]

  @@index([deptId])
  @@map("sys_user")
}

model SysRole {
  id         BigInt   @id @default(autoincrement())
  name       String   @db.VarChar(64)
  code       String   @unique(map: "uk_code") @db.VarChar(64)
  status     Int      @default(1) @db.TinyInt
  remark     String?  @db.VarChar(500)
  createTime DateTime @default(now()) @map("create_time") @db.DateTime(0)

  userRoles  SysUserRole[]
  roleMenus SysRoleMenu[]

  @@map("sys_role")
}

model SysUserRole {
  userId BigInt @map("user_id")
  roleId BigInt @map("role_id")

  user SysUser @relation(fields: [userId], references: [id])
  role SysRole @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("sys_user_role")
}

model SysMenu {
  id         BigInt   @id @default(autoincrement())
  pid        BigInt   @default(0) @map("pid")
  name       String   @unique(map: "uk_name") @db.VarChar(64)
  type       String   @default("menu") @db.VarChar(16)
  path       String?  @db.VarChar(255)
  component  String?  @db.VarChar(255)
  redirect   String?  @db.VarChar(255)
  authCode   String?  @map("auth_code") @db.VarChar(128)
  icon       String?  @db.VarChar(128)
  status     Int      @default(1) @db.TinyInt
  sort       Int      @default(0)
  meta       Json?
  createTime DateTime @default(now()) @map("create_time") @db.DateTime(0)
  updateTime DateTime @default(now()) @map("update_time") @db.DateTime(0)

  roleMenus  SysRoleMenu[]

  @@map("sys_menu")
}

model SysRoleMenu {
  roleId BigInt @map("role_id")
  menuId BigInt @map("menu_id")

  role SysRole @relation(fields: [roleId], references: [id])
  menu SysMenu @relation(fields: [menuId], references: [id])

  @@id([roleId, menuId])
  @@map("sys_role_menu")
}

model SysDept {
  id         BigInt   @id @default(autoincrement())
  pid        BigInt   @default(0) @map("pid")
  name       String   @db.VarChar(64)
  status     Int      @default(1) @db.TinyInt
  remark     String?  @db.VarChar(500)
  createTime DateTime @default(now()) @map("create_time") @db.DateTime(0)

  @@map("sys_dept")
}

model SysRefreshToken {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  tokenHash String   @unique(map: "uk_token_hash") @map("token_hash") @db.VarChar(128)
  expiresAt DateTime @map("expires_at") @db.DateTime(0)
  revoked   Int      @default(0) @db.TinyInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  user      SysUser  @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_user_id")
  @@map("sys_refresh_token")
}

model SysNotice {
  id         BigInt   @id @default(autoincrement())
  title      String   @db.VarChar(128)
  message    String?  @db.Text
  avatar     String?  @db.VarChar(255)
  link       String?  @db.VarChar(255)
  isRead     Int      @default(0) @map("is_read") @db.TinyInt
  userId     BigInt   @map("user_id")
  roleId     BigInt?  @map("role_id")
  type       String?  @default("info") @db.VarChar(32)
  createTime DateTime @default(now()) @map("create_time") @db.DateTime(0)

  user       SysUser  @relation(fields: [userId], references: [id])

  @@index([roleId], map: "idx_role_id")
  @@index([userId], map: "idx_user_id")
  @@map("sys_notice")
}

model SysConfig {
  id         BigInt   @id @default(autoincrement())
  name       String   @db.VarChar(100)
  key        String   @unique(map: "uk_key") @db.VarChar(100)
  value      String   @db.Text
  type       String?  @default("string") @db.VarChar(20)
  remark     String?  @db.VarChar(500)
  createTime DateTime @default(now()) @map("create_time") @db.DateTime(0)
  updateTime DateTime @default(now()) @map("update_time") @db.DateTime(0)

  @@map("sys_config")
}

model SysJob {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(100)
  groupName    String?  @default("DEFAULT") @map("group_name") @db.VarChar(50)
  invokeTarget String   @map("invoke_target") @db.VarChar(255)
  cron         String   @db.VarChar(100)
  status       Int      @default(0) @db.TinyInt
  remark       String?  @db.VarChar(500)
  createTime   DateTime @default(now()) @map("create_time") @db.DateTime(0)

  @@map("sys_job")
}

model SysDictType {
  id         BigInt   @id @default(autoincrement())
  name       String   @db.VarChar(100)
  code       String   @unique(map: "uk_code") @db.VarChar(100)
  status     Int      @default(1) @db.TinyInt
  remark     String?  @db.VarChar(500)
  createTime DateTime @default(now()) @map("create_time") @db.DateTime(0)
  updateTime DateTime @default(now()) @map("update_time") @db.DateTime(0)

  dictData   SysDictData[]

  @@map("sys_dict_type")
}

model SysDictData {
  id         BigInt   @id @default(autoincrement())
  typeId     BigInt   @map("type_id")
  label      String   @db.VarChar(100)
  value      String   @db.VarChar(100)
  sort       Int      @default(0)
  status     Int      @default(1) @db.TinyInt
  cssClass   String?  @map("css_class") @db.VarChar(100)
  remark     String?  @db.VarChar(500)
  createTime DateTime @default(now()) @map("create_time") @db.DateTime(0)

  dictType   SysDictType @relation(fields: [typeId], references: [id])

  @@index([typeId], map: "idx_type_id")
  @@map("sys_dict_data")
}

model SysMessage {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @default(0) @map("user_id")
  senderId   BigInt    @default(0) @map("sender_id")
  title      String    @db.VarChar(255)
  content    String?   @db.Text
  type       String?   @default("notice") @db.VarChar(50)
  bizId      String?   @map("biz_id") @db.VarChar(100)
  isRead     Int       @default(0) @map("is_read") @db.TinyInt
  createTime DateTime? @default(now()) @map("create_time") @db.DateTime(0)

  @@index([createTime], map: "idx_create_time")
  @@index([userId, isRead], map: "idx_user_read")
  @@map("sys_message")
}

model SysAttachment {
  id             BigInt    @id @default(autoincrement())
  originalName   String    @map("original_name") @db.VarChar(500)
  storagePath    String    @map("storage_path") @db.VarChar(500)
  fileSize       BigInt?   @default(0) @map("file_size")
  contentType    String?   @map("content_type") @db.VarChar(200)
  fileExt        String?   @map("file_ext") @db.VarChar(20)
  md5Hash        String?   @map("md5_hash") @db.VarChar(64)
  uploadUserId   BigInt?   @default(0) @map("upload_user_id")
  uploadUsername String?   @map("upload_username") @db.VarChar(100)
  bizType        String?   @map("biz_type") @db.VarChar(50)
  bizId          String?   @map("biz_id") @db.VarChar(100)
  url            String?   @db.VarChar(500)
  createTime     DateTime? @default(now()) @map("create_time") @db.DateTime(0)

  @@index([bizType, bizId], map: "idx_biz")
  @@index([createTime], map: "idx_create_time")
  @@index([md5Hash], map: "idx_md5")
  @@map("sys_attachment")
}

model SysAuditLog {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt?   @default(0) @map("user_id")
  username      String?   @db.VarChar(100)
  module        String?   @db.VarChar(50)
  operation     String?   @db.VarChar(20)
  entityType    String?   @map("entity_type") @db.VarChar(100)
  entityId      String?   @map("entity_id") @db.VarChar(64)
  oldData       String?   @map("old_data") @db.Text
  newData       String?   @map("new_data") @db.Text
  changedFields String?   @map("changed_fields") @db.Text
  ip            String?   @db.VarChar(64)
  createTime    DateTime? @default(now()) @map("create_time") @db.DateTime(0)

  @@index([createTime], map: "idx_create_time")
  @@index([entityType, entityId], map: "idx_entity")
  @@index([module], map: "idx_module")
  @@map("sys_audit_log")
}

model SysWorkflow {
  id         BigInt    @id @default(autoincrement())
  name       String    @db.VarChar(100)
  code       String    @unique(map: "uk_code") @db.VarChar(50)
  type       String?   @default("approval") @db.VarChar(50)
  definition String?   @db.Text
  status     Int       @default(1) @db.TinyInt
  remark     String?   @db.VarChar(500)
  createTime DateTime? @default(now()) @map("create_time") @db.DateTime(0)

  @@map("sys_workflow")
}

model SysWorkflowInstance {
  id            BigInt    @id @default(autoincrement())
  workflowId    BigInt    @map("workflow_id")
  workflowName  String?   @map("workflow_name") @db.VarChar(100)
  applicantId   BigInt    @map("applicant_id")
  applicantName String?   @map("applicant_name") @db.VarChar(100)
  title         String    @db.VarChar(200)
  content       String?   @db.Text
  currentStep   Int?      @default(0) @map("current_step")
  totalSteps    Int?      @default(0) @map("total_steps")
  status        String?   @default("pending") @db.VarChar(20)
  bizType       String?   @map("biz_type") @db.VarChar(50)
  bizId         String?   @map("biz_id") @db.VarChar(64)
  createTime    DateTime? @default(now()) @map("create_time") @db.DateTime(0)
  finishTime    DateTime? @map("finish_time") @db.DateTime(0)

  @@index([applicantId], map: "idx_applicant")
  @@index([status], map: "idx_status")
  @@map("sys_workflow_instance")
}

model SysWorkflowTask {
  id           BigInt    @id @default(autoincrement())
  instanceId   BigInt    @map("instance_id")
  step         Int
  approverId   BigInt    @map("approver_id")
  approverName String?   @map("approver_name") @db.VarChar(100)
  action       String    @db.VarChar(20)
  comment      String?   @db.Text
  approveTime  DateTime? @default(now()) @map("approve_time") @db.DateTime(0)

  @@index([instanceId], map: "idx_instance")
  @@map("sys_workflow_task")
}

model SysOperationLog {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt?  @map("user_id")
  username      String?  @db.VarChar(64)
  module        String?  @db.VarChar(64)
  description   String?  @db.VarChar(255)
  method        String?  @db.VarChar(255)
  requestUrl    String?  @map("request_url") @db.VarChar(255)
  requestMethod String?  @map("request_method") @db.VarChar(16)
  requestParams String?  @map("request_params") @db.Text
  ip            String?  @db.VarChar(64)
  status        Int      @default(1) @db.TinyInt
  errorMsg      String?  @map("error_msg") @db.Text
  costTime      BigInt?  @map("cost_time")
  createTime    DateTime @default(now()) @map("create_time") @db.DateTime(0)

  @@index([createTime], map: "idx_create_time")
  @@index([userId], map: "idx_user_id")
  @@map("sys_operation_log")
}

model SysLoginLog {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt?  @map("user_id")
  username   String?  @db.VarChar(64)
  ip         String?  @db.VarChar(64)
  location   String?  @db.VarChar(255)
  browser    String?  @db.VarChar(128)
  os         String?  @db.VarChar(128)
  status     Int      @default(1) @db.TinyInt
  message    String?  @db.VarChar(255)
  loginType  String?  @map("login_type") @db.VarChar(32)
  createTime DateTime @default(now()) @map("create_time") @db.DateTime(0)

  @@index([createTime], map: "idx_create_time")
  @@index([userId], map: "idx_user_id")
  @@map("sys_login_log")
}
